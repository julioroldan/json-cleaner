{
  "name": "json-cleaner",
  "publisher": "JulioRoldan",
  "displayName": "Json-Cleaner",
  "description": "It is an extension to clean Json and only have the properties we need, clean and easy.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "package-explorer": [
        {
          "id": "package-Arbol",
          "name": "Tree Json"
        }
      ]
    },
    "commands": [
      {
        "command": "nodeDependencies.updateJson",
        "title": "update Json",
        "icon": {
          "light": "resources/update.svg",
          "dark": "resources/update.svg"
        }
      },
      {
        "command": "nodeDependencies.newFile",
        "title": "New File",
        "icon": {
          "light": "resources/newFile.svg",
          "dark": "resources/newFile.svg"
        }
      },
      {
        "command": "nodeDependencies.updateDocument",
        "title": "change File",
        "icon": {
          "light": "resources/changeFile.svg",
          "dark": "resources/changeFile.svg"
        }
      },
      {
        "command": "nodeDependencies.togglePreview",
        "title": "Toggle JSON Preview",
        "icon": "$(split-horizontal)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "nodeDependencies.togglePreview",
          "when": "view == package-Arbol",
          "group": "navigation@0"
        },
        {
          "command": "nodeDependencies.updateJson",
          "when": "view == package-Arbol",
          "group": "navigation@1"
        },
        {
          "command": "nodeDependencies.newFile",
          "when": "view == package-Arbol",
          "group": "navigation@2"
        },
        {
          "command": "nodeDependencies.updateDocument",
          "when": "view == package-Arbol",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "nodeDependencies.togglePreview",
          "when": "resourceLangId == json",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/uuid": "^9.0.8",
    "@types/vscode": "^1.86.0",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.9",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "uuid": "^9.0.1"
  },
  "license":"license.txt"
}
